{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ],
  "redirects": [
    { "source": "/token{/}?", "destination": "https://token.spidertag.vyvanse.beer/", "permanent": false },
    { "source": "/token/:path+", "destination": "https://token.spidertag.vyvanse.beer/:path+", "permanent": false },
    { "source": "/", "has": [{ "type": "host", "value": "radrun.vyvanse.beer" }], "destination": "https://spidertag.vyvanse.beer/", "permanent": true },
    { "source": "/:path((?!carry\\.html$).+)", "has": [{ "type": "host", "value": "radrun.vyvanse.beer" }], "destination": "https://spidertag.vyvanse.beer/:path", "permanent": true },
    { "source": "/", "has": [{ "type": "host", "value": "rugrun.vyvanse.beer" }], "destination": "https://spidertag.vyvanse.beer/", "permanent": true },
    { "source": "/:path+", "has": [{ "type": "host", "value": "rugrun.vyvanse.beer" }], "destination": "https://spidertag.vyvanse.beer/:path+", "permanent": true },
    { "source": "/", "has": [{ "type": "host", "value": "radbro-rug-run.vercel.app" }], "destination": "https://spidertag.vyvanse.beer/", "permanent": true },
    { "source": "/:path+", "has": [{ "type": "host", "value": "radbro-rug-run.vercel.app" }], "destination": "https://spidertag.vyvanse.beer/:path+", "permanent": true }
  ]
}
